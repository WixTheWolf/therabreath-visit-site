{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/email-pdf", "destination": "/booklet/documents/july-8-email-packet.pdf", "permanent": false },
    { "source": "/july8-pdf", "destination": "/booklet/documents/july-8-briefing.pdf", "permanent": false },
    { "source": "/july8-docx", "destination": "/booklet/documents/july-8-briefing.docx", "permanent": false },
    { "source": "/agenda", "destination": "/booklet/documents/suggested-agenda-therabreath.pdf", "permanent": false },
    { "source": "/presentation", "destination": "/present", "permanent": false },
    { "source": "/tv", "destination": "/display", "permanent": false },
    { "source": "/speaker-packet", "destination": "/packet", "permanent": false },
    { "source": "/team", "destination": "/gate", "permanent": false },
    { "source": "/mystery", "destination": "/taste", "permanent": false },
    { "source": "/map", "destination": "/taste", "permanent": false }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
